#!/usr/bin/env bash
# docker finto per test/test.sh: risponde leggendo la scena in $SCENA e annota gli interventi
# in $SCENA/chiamate. Per ogni app (nome della cartella) $SCENA/<app>/ contiene:
#   servizi      i servizi del compose, uno per riga
#   contenitori  id|servizio|oneoff|stato|salute|politica|uscita|/nome
#   cartella     dove sta il compose (per "compose ls")
#   config-rotto, up-rotto   se ci sono, quei comandi falliscono
app=$(basename "$PWD")
case $1 in
    info)
        [ -e "$SCENA/docker-giu" ] && exit 1
        exit 0 ;;
    inspect)
        shift
        formato=""
        [ "$1" = --format ] && { formato=$2; shift 2; }
        for id in "$@"; do
            riga=$(grep -h "^$id|" "$SCENA"/*/contenitori)
            if [[ $formato == *"json .State"* ]]; then
                # Formato della fotografia: nome|servizio|oneoff|politica|immagine|riavvii|.State in JSON
                IFS='|' read -r _ servizio oneoff stato salute politica uscita nome <<< "$riga"
                salute_json=""
                [ "$salute" != - ] && salute_json=',"Health":{"Status":"'$salute'","FailingStreak":0,"Log":[{"Start":"2026-11-07T10:00:00Z","End":"2026-11-07T10:00:01Z","ExitCode":1,"Output":"wget: can'"'"'t connect | prova\n"}]}'
                echo "$nome|$servizio|$oneoff|$politica|immagine/$servizio:1|2|{\"Status\":\"$stato\",\"Running\":true,\"ExitCode\":$uscita,\"Error\":\"\",\"StartedAt\":\"2026-11-07T09:00:00.123456789Z\",\"FinishedAt\":\"0001-01-01T00:00:00Z\"$salute_json}"
            else
                echo "$riga" | cut -d'|' -f2-
            fi
        done ;;
    logs)
        nome=${!#}
        echo "2026-11-07T10:00:00.000000000Z primo messaggio di $nome"
        printf '2026-11-07T10:00:01.000000000Z \033[31mrosso\033[0m <b>non html</b>\n' ;;
    restart)
        echo "restart $2" >> "$SCENA/chiamate"
        echo "$2" ;;
    stop)
        echo "stop $2" >> "$SCENA/chiamate"
        [ -e "$SCENA/stop-rotto" ] && { echo "Error response from daemon: cannot stop container"; exit 1; }
        echo "$2" ;;
    compose)
        shift
        case $1 in
            config)
                [ -e "$SCENA/$app/config-rotto" ] && { echo "manca DB_PASSWD nel .env" >&2; exit 15; }
                cat "$SCENA/$app/servizi" ;;
            ps)
                cut -d'|' -f1 "$SCENA/$app/contenitori" ;;
            up)
                shift
                [ "${1:-}" = -d ] && shift
                echo "up $app${1:+ $1}" >> "$SCENA/chiamate"
                [ -e "$SCENA/$app/up-rotto" ] && { echo "Error: port is already allocated"; exit 1; }
                echo " Container $app-1  Started" ;;
            ls)
                echo "NAME                STATUS              CONFIG FILES"
                for d in "$SCENA"/*/; do
                    [ -f "$d/cartella" ] && echo "$(basename "$d")   exited(1), running(1)   $(cat "$d/cartella")/docker-compose.yml"
                done
                [ -f "$SCENA/progetti-extra" ] && cat "$SCENA/progetti-extra"
                exit 0 ;;
        esac ;;
    *)
        echo "docker finto: comando non previsto: $*" >&2
        exit 99 ;;
esac
